{
  // Used by js.Babel in layouts/partials/essentials/script.html.
  // "firefox >= 48" keeps KaiOS 2.x (Gecko 48) working, see also the
  // minify.tdewolff.js.version setting in hugo.toml.
  // The bundles are plain concatenated scripts (UMD plugins rely on a
  // top-level `this`), so they must not be parsed as ES modules.
  "sourceType": "script",
  "plugins": ["./scripts/babel-keep-math-calls.cjs"],
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": ">0.5%, last 2 versions, Firefox ESR, not dead, firefox >= 48",
        "modules": false
      }
    ]
  ]
}
